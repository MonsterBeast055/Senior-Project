# Path to the compiled engine. This is the only setting you must get right.
SP_BINARY=C:\Users\rozan\Desktop\Senior-Project\out\build\x64-release\Senior-Project\sp.exe

# Where uploads and analysis output are stored. Created if missing.
DATA_DIR=./data

PORT=3000

# Where this server sends work for the AI layer. Leave unset until n8n exists.
# While it is unset the lift/explain endpoints report "not-run" instead of
# failing, so the UI stays usable.
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/lift

# How hard to push the AI layer.
#
# Free and low model tiers meter by requests per minute, so both of these
# matter: concurrency bounds how many calls are open at once, the gap bounds how
# fast they leave. Lower either one if the provider returns 429.
#   AI_CONCURRENCY=2      simultaneous requests towards n8n
#   AI_MIN_GAP_MS=1500    minimum spacing between requests, milliseconds
# AI_CONCURRENCY=2
# AI_MIN_GAP_MS=1500
#
# How long a dispatched function may wait for its callback before it is counted
# as failed. Without a bound, one reply that never arrives leaves the stage at
# 199 of 200 forever and the automated run never advances past it.
#   AI_SEND_TIMEOUT_MS=300000   five minutes

# Where n8n posts results back. Defaults to http://localhost:PORT, which is
# correct only when n8n runs on this same machine.
#
# If n8n is on another host — a teammate's laptop, a Docker container, a tunnel
# — set this to an address that host can reach, e.g. http://192.168.1.75:3000.
# Getting it wrong fails silently: the forward succeeds and the model runs, but
# the answer is posted to the wrong machine and the pane waits forever.
# PUBLIC_BASE_URL=http://192.168.1.75:3000
